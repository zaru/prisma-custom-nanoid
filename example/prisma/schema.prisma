generator client {
  provider = "prisma-client"
  output   = "./generated"
}

generator customNanoid {
  provider = "prisma-custom-nanoid-generator"
  output   = "./generated-custom-nanoid"
}

datasource db {
  provider = "sqlite"
}

model User {
  /// @customNanoid(alphabet: "0123456789abcdefghijklmnopqrstuvwxyz")
  id     String @id @default(nanoid(16))
  email  String @unique
  posts  Post[]
}

model Post {
  /// @customNanoid(alphabet: "abcdefghijklmnopqrstuvwxyz")
  id       String @id @default(nanoid(12))
  title    String
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ApiKey {
  /// @customNanoid(alphabet: "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ")
  id    String @id @default(nanoid(24))
  label String
}

model Counter {
  id    Int @id @default(autoincrement())
  value Int
}
