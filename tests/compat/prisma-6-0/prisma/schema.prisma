generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

generator customNanoid {
  provider = "node ../../../dist/generator.js"
  output   = "../generated-custom-nanoid"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model User {
  /// @customNanoid(alphabet: "abc123")
  id    String @id @default(nanoid(12))
  email String @unique
  posts Post[]
}

model Post {
  /// @customNanoid(alphabet: "def456")
  id       String @id @default(nanoid(10))
  title    String
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
}

model Comment {
  /// @customNanoid(alphabet: "ghi789")
  id     String @id @default(nanoid(9))
  body   String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}
